# SimuGuard-X Environment Configuration Template
# Copy this file to .env and insert your API keys if performing live LLM inference.
# Pre-synthesized benchmark artifacts in cache/ run 100% offline without any API key.

# OpenAI API Key (used for gpt-4o-2024-08-06 synthesis)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Fireworks API Key (for alternative open models)
FIREWORKS_API_KEY=your_fireworks_api_key_here
